#!/usr/bin/env nu
#
# odin-update -- install / update the Odin toolchain (compiler + OLS) from
# upstream GitHub releases. Neither is installed from a package: the repos lag
# behind the monthly dev releases, so this reproduces the hand-rolled layout:
#
#   ~/.local/opt/odin/{odin,base,core,vendor,shared,examples,LICENSE}   (odin-lang/Odin)
#   ~/.local/opt/ols/{ols,odinfmt,builtin}                             (DanielGavin/ols)
#   ~/.local/bin/{odin,ols,odinfmt} -> the two opt dirs
#
# Each install dir gets a .release-tag marker (tag / asset digest / commit) so
# re-running is a no-op unless upstream actually published something new.
#
# Examples:
#   odin-update                      # compiler + language server
#   odin-update --dry-run            # show the plan, download nothing
#   odin-update --odin-only          # just the compiler
#   odin-update --ols-only           # just ols + odinfmt
#   odin-update --force              # reinstall even when current
#   odin-update --odin-tag dev-2026-11
#   odin-update --ols-tag dev-2026-11 # pin a release (default: newest, incl. nightly)
#   odin-update --prefix /tmp/odin --ols-prefix /tmp/ols   # install elsewhere

const ODIN_REPO = "odin-lang/Odin"
const OLS_REPO = "DanielGavin/ols"
const MARKER = ".release-tag"

def die [msg: string] {
    error make { msg: $msg }
}

# amd64 / arm64, the naming Odin uses in its release assets.
def detect-arch [] {
    let m = (^uname -m | str trim)
    if $m in ["x86_64" "amd64"] { return "amd64" }
    if $m in ["aarch64" "arm64"] { return "arm64" }
    die $"unsupported architecture: ($m)"
}

def gh-out [cmd: list<string>] {
    let res = (^gh ...$cmd | complete)
    if $res.exit_code != 0 {
        die $"gh ($cmd | str join ' ') failed: ($res.stderr | str trim)"
    }
    $res.stdout | str trim
}

# Newest stable release tag. `latest-any-tag` also considers pre-releases, which
# is what OLS's rolling `nightly` release is.
def latest-tag [repo: string] {
    gh-out ["release" "list" "-R" $repo "--limit" "30" "--json" "tagName,publishedAt,isPrerelease"]
    | from json
    | where {|r| not $r.isPrerelease }
    | sort-by publishedAt --reverse
    | get tagName
    | first
}

def latest-any-tag [repo: string] {
    gh-out ["release" "list" "-R" $repo "--limit" "20" "--json" "tagName,publishedAt"]
    | from json
    | sort-by publishedAt --reverse
    | get tagName
    | first
}

def release-assets [repo: string, tag: string] {
    gh-out ["release" "view" $tag "-R" $repo "--json" "assets"]
    | from json
    | get assets
}

def pick-asset [repo: string, tag: string, pattern: string] {
    let found = (release-assets $repo $tag | where {|a| $a.name =~ $pattern })
    if ($found | is-empty) {
        die $"no asset matching /($pattern)/ in ($repo)@($tag)"
    }
    $found | first
}

def tag-commit [repo: string, tag: string] {
    gh-out ["api" $"repos/($repo)/commits/($tag)" "--jq" ".sha"]
}

# Commit an installed binary embeds in its version banner, or null.
# odin: "dev-2026-10-nightly:84bc3fc"   -> after ':' is the commit
# ols : "nightly-2026-11-22-459ffb7e"   -> last '-' field is the commit (nightlies only)
def installed-cookie [bin: path, kind: string] {
    if not ($bin | path exists) { return null }
    let res = (^$bin version | complete)
    if $res.exit_code != 0 { return null }
    let line = ($res.stdout | str trim | lines | first)
    if $kind == "odin" {
        return ($line | split row ':' | last | str trim)
    }
    let tail = ($line | split row '-' | last | str trim)
    if ($tail =~ '^[0-9a-f]{7,}$') { $tail } else { null }
}

def read-marker [dir: path] {
    let f = ($dir | path join $MARKER)
    if not ($f | path exists) { return {} }
    open $f | lines
    | where {|l| $l =~ '=' }
    | parse '{key}={value}'
    | reduce --fold {} {|it, acc| $acc | upsert $it.key $it.value }
}

def write-marker [dir: path, tag: string, digest: string, commit: string] {
    $"tag=($tag)\ndigest=($digest)\ncommit=($commit)\n" | save --force ($dir | path join $MARKER)
}

# gh release download, retried: GitHub occasionally 404s a valid tag.
def fetch [repo: string, tag: string, asset: string, dir: string] {
    mut last = { exit_code: 1, stdout: '', stderr: 'not attempted' }
    for attempt in 1..3 {
        $last = (^gh release download $tag -R $repo --pattern $asset --dir $dir --clobber | complete)
        if $last.exit_code == 0 { return }
        print $"  attempt ($attempt) failed: ($last.stderr | str trim)"
        sleep 2sec
    }
    die $"download of ($asset) failed: ($last.stderr | str trim)"
}

# Put `payload` at `dest`, keeping the previous tree aside until it is verified.
# Returns the backup path, or null when there was nothing to replace.
def swap-in [payload: path, dest: path] {
    let backup = $"($dest).old"
    rm -rf $backup
    let existed = ($dest | path exists)
    if $existed { mv $dest $backup }
    mv $payload $dest
    if $existed { $backup } else { null }
}

def link-bin [target: path, link_dir: path, name: string] {
    mkdir $link_dir
    ^ln --symbolic --force $target ($link_dir | path join $name)
}

def main [
    --odin-only (-o)                 # only the compiler
    --ols-only (-l)                  # only the language server (ols + odinfmt)
    --force (-f)                     # reinstall even when already current
    --odin-tag (-t): string          # pin the compiler release tag
    --ols-tag: string                # pin the ols release tag (default: newest, incl. nightly)
    --prefix (-p): string            # compiler install dir (default: ~/.local/opt/odin)
    --ols-prefix: string             # ols install dir (default: ~/.local/opt/ols)
    --bin-dir (-b): string           # where to put the symlinks (default: ~/.local/bin)
    --dry-run (-n)                   # print the plan and stop
] {
    let arch = (detect-arch)
    let work = (^mktemp -d | str trim)
    let bin_dir = ($bin_dir | default ($nu.home-dir | path join ".local" "bin") | path expand --no-symlink)

    try {
        if not $ols_only { do-odin $arch $work $bin_dir $odin_tag $prefix $force $dry_run }
        if not $odin_only { do-ols $arch $work $bin_dir $ols_tag $ols_prefix $force $dry_run }
    } catch {|e|
        rm -rf $work
        die $e.msg
    }
    rm -rf $work

    if not $dry_run {
        print $"\nRun `ols version` and `odin version` to confirm; nothing else to do."
    }
}

def do-odin [
    arch: string, work: path, bin_dir: path,
    tag: any, prefix: any, force: bool, dry_run: bool,
] {
    let opt = ($prefix | default ($nu.home-dir | path join ".local" "opt" "odin") | path expand --no-symlink)
    let bin = ($opt | path join "odin")
    let target = ($tag | default (latest-tag $ODIN_REPO))
    let commit = (tag-commit $ODIN_REPO $target)
    let current = (installed-cookie $bin "odin")
    let prev = (read-marker $opt)

    print "\n== Odin compiler =="
    print $"  release   : ($target)  [commit ($commit | str substring 0..6)]"
    print $"  installed : ($current | default 'none')  at ($opt)"

    if $current == ($commit | str substring 0..6) and not $force {
        print "  status    : already up to date"
        return
    }

    let asset = (pick-asset $ODIN_REPO $target $"^odin-linux-($arch)-.*\\.tar\\.gz$")
    print $"  asset     : ($asset.name)"
    if $dry_run { print "  status    : would install (dry run)"; return }

    fetch $ODIN_REPO $target $asset.name $work
    let tarball = ($work | path join $asset.name)
    let unpack = (^tar -xzf $tarball -C $work | complete)
    if $unpack.exit_code != 0 { die $"extract failed: ($unpack.stderr | str trim)" }
    # Single top-level dir: odin-linux-<arch>-nightly+<date>/
    let payload = (ls $work | where type == dir | get name | first)

    let backup = (swap-in $payload $opt)
    write-marker $opt $target $asset.digest $commit
    link-bin ($opt | path join "odin") $bin_dir "odin"

    let reported = (^$bin version | str trim | lines | first)
    if (installed-cookie $bin "odin") != ($commit | str substring 0..6) {
        if $backup != null { rm -rf $opt; mv $backup $opt }
        die $"post-install check failed: ($reported) does not match ($target)"
    }
    if $backup != null { rm -rf $backup }
    rm -f $tarball
    print $"  installed ($reported)"
    print $"  linked    ($bin_dir | path join 'odin') -> ($opt | path join 'odin')"
}

def do-ols [
    arch: string, work: path, bin_dir: path,
    tag: any, prefix: any, force: bool, dry_run: bool,
] {
    let opt = ($prefix | default ($nu.home-dir | path join ".local" "opt" "ols") | path expand --no-symlink)
    let triple = (if $arch == "amd64" { "x86_64" } else { "arm64" }) + "-unknown-linux-gnu"
    let target = ($tag | default (latest-any-tag $OLS_REPO))
    let commit = (tag-commit $OLS_REPO $target)
    let prev = (read-marker $opt)
    let current = (installed-cookie ($opt | path join "ols") "ols")

    print "\n== Odin language server (ols) =="
    print $"  release   : ($target)  [commit ($commit | str substring 0..6)]"
    print $"  installed : ($current | default 'none')  at ($opt)"

    let asset = (pick-asset $OLS_REPO $target $"^ols-($arch | str replace amd64 x86_64)-.*linux.*\\.zip$")
    print $"  asset     : ($asset.name)"

    if $prev.digest? == $asset.digest and not $force {
        print "  status    : already up to date"
        return
    }
    if $dry_run { print "  status    : would install (dry run)"; return }

    fetch $OLS_REPO $target $asset.name $work
    let zip = ($work | path join $asset.name)
    let unpack = (^unzip -oq $zip -d ($work | path join "ols") | complete)
    if $unpack.exit_code != 0 { die $"extract failed: ($unpack.stderr | str trim)" }

    # The zip is flat: ols-<triple>, odinfmt-<triple>, builtin/. Rename the pair.
    let raw = ($work | path join "ols")
    let payload = ($work | path join "ols.payload")
    mkdir $payload
    mv ($raw | path join "builtin") ($payload | path join "builtin")
    let ols_bin = (ls $raw | where {|f| ($f.name | path basename) starts-with "ols-" } | get name | first)
    let fmt_bin = (ls $raw | where {|f| ($f.name | path basename) starts-with "odinfmt-" } | get name | first)
    mv $ols_bin ($payload | path join "ols")
    mv $fmt_bin ($payload | path join "odinfmt")
    ^chmod +x ($payload | path join "ols") ($payload | path join "odinfmt")

    let backup = (swap-in $payload $opt)
    write-marker $opt $target $asset.digest $commit
    link-bin ($opt | path join "ols") $bin_dir "ols"
    link-bin ($opt | path join "odinfmt") $bin_dir "odinfmt"

    let reported = (^($opt | path join "ols") version | str trim | lines | first)
    if $backup != null { rm -rf $backup }
    rm -f $zip
    print $"  installed ($reported)"
    print $"  linked    ($bin_dir | path join 'ols'), ($bin_dir | path join 'odinfmt')"
}
