#!/usr/bin/env nu
#
# odin-update -- install / update the Odin compiler from odin-lang/Odin releases.
#
# This reproduces the hand-rolled layout (Odin is not packaged because the
# repos lag behind the monthly dev releases):
#
#   ~/.local/opt/odin/{odin,base,core,vendor,shared,examples,LICENSE}
#   ~/.local/bin/odin -> ~/.local/opt/odin/odin
#
# Examples:
#   odin-update                        # update to the newest release
#   odin-update --dry-run              # show what would happen
#   odin-update --force                # reinstall even if already current
#   odin-update --tag dev-2026-11      # pin a specific release
#   odin-update --prefix /tmp/odin     # install somewhere else (for testing)

const REPO = "odin-lang/Odin"
const TAG_MARKER = ".release-tag"

# x86_64 -> amd64, aarch64 -> arm64 (the names used in the release assets)
def detect-arch [] {
    let m = (^uname -m | str trim)
    if $m in ["x86_64" "amd64"] { return "amd64" }
    if $m in ["aarch64" "arm64"] { return "arm64" }
    error make { msg: $"unsupported architecture: ($m)" }
}

# Newest non-prerelease tag, straight from `gh release list`.
def latest-tag [] {
    let res = (^gh release list -R $REPO --limit 30
        --json tagName,publishedAt,isPrerelease | complete)
    if $res.exit_code != 0 {
        error make { msg: $"gh release list failed: ($res.stderr | str trim)" }
    }
    $res.stdout
    | from json
    | where {|r| not $r.isPrerelease }
    | sort-by publishedAt --reverse
    | get tagName
    | first
}

# The linux tarball for this arch, e.g. odin-linux-amd64-dev-2026-11a.tar.gz
def asset-name [tag: string, arch: string] {
    let res = (^gh release view $tag -R $REPO --json assets | complete)
    if $res.exit_code != 0 {
        error make { msg: $"gh release view ($tag) failed: ($res.stderr | str trim)" }
    }
    let found = (
        $res.stdout
        | from json
        | get assets.name
        | where {|n| $n =~ $"^odin-linux-($arch)-" and ($n | str ends-with ".tar.gz") }
    )
    if ($found | is-empty) {
        error make { msg: $"no linux-($arch) tarball in release ($tag)" }
    }
    $found | first
}

# Commit the tag points at; the compiler reports it after the ':' in `odin version`.
def tag-commit [tag: string] {
    let res = (^gh api $"repos/($REPO)/commits/($tag)" --jq .sha | complete)
    if $res.exit_code != 0 {
        error make { msg: $"gh api commits/($tag) failed: ($res.stderr | str trim)" }
    }
    $res.stdout | str trim | str substring 0..6
}

# Commit baked into an already-installed binary, or null if there is none.
def installed-commit [bin: path] {
    if not ($bin | path exists) { return null }
    let res = (^$bin version | complete)
    if $res.exit_code != 0 { return null }
    $res.stdout | str trim | lines | first | split row ':' | last | str trim
}

def main [
    --force (-f)            # reinstall even when already on the newest tag
    --tag (-t): string      # install this release tag instead of the newest
    --prefix (-p): string   # install dir (default: ~/.local/opt/odin)
    --bin-dir (-b): string  # where to put the symlink (default: ~/.local/bin, none for a custom --prefix)
    --dry-run (-n)          # print the plan and stop
] {
    let arch = (detect-arch)
    let opt = (
        $prefix | default ($nu.home-dir | path join ".local" "opt" "odin")
        | path expand --no-symlink
    )
    let link_dir = (
        $bin_dir | default (if $prefix == null { $nu.home-dir | path join ".local" "bin" })
    )
    let linker = (if $link_dir == null { null } else { $link_dir | path join "odin" })
    let bin = ($opt | path join "odin")

    let target = ($tag | default (latest-tag))
    let wanted = (tag-commit $target)
    let current = (installed-commit $bin)

    let shown = (if $current == null { 'none' } else { $current })
    print $"repo      : ($REPO)"
    print $"release   : ($target)  [commit ($wanted)]"
    print $"installed : ($shown)  at ($opt)"
    print $"platform  : linux-($arch)"

    if $current == $wanted and not $force {
        print "\nAlready up to date."
        return
    }

    let art = (asset-name $target $arch)
    print $"asset     : ($art)"
    if $dry_run {
        print "\nDry run: nothing downloaded."
        return
    }

    let tmp = (^mktemp -d | str trim)
    print $"\nDownloading to ($tmp) ..."
    # GitHub occasionally answers 404/502 for a valid tag; retry a couple of times.
    mut dl = { exit_code: 1, stdout: '', stderr: 'not attempted' }
    for attempt in 1..3 {
        $dl = (^gh release download $target -R $REPO --pattern $art --dir $tmp --clobber
            | complete)
        if $dl.exit_code == 0 { break }
        print $"  attempt ($attempt) failed: ($dl.stderr | str trim)"
        sleep 2sec
    }
    if $dl.exit_code != 0 {
        rm -rf $tmp
        error make { msg: $"download failed: ($dl.stderr | str trim)" }
    }

    let unpack = (^tar -xzf ($tmp | path join $art) -C $tmp | complete)
    if $unpack.exit_code != 0 {
        rm -rf $tmp
        error make { msg: $"extract failed: ($unpack.stderr | str trim)" }
    }

    # The tarball holds a single directory (odin-linux-<arch>-nightly+<date>/).
    let payload = (ls $tmp | where type == dir | get name | first)

    let backup = $"($opt).old"
    if ($opt | path exists) {
        rm -rf $backup
        mv $opt $backup
    }
    mv $payload $opt
    $"($target) ($wanted)\n" | save --force ($opt | path join $TAG_MARKER)

    if $linker != null {
        mkdir ($linker | path dirname)
        ^ln --symbolic --force ($opt | path join "odin") $linker
    }

    rm -rf $backup
    rm -rf $tmp

    print $"Installed ($target) -> ($opt)"
    if $linker == null {
        print "No symlink created; pass --bin-dir <dir> to link it onto PATH."
    } else {
        print $"Linked    ($linker) -> ($opt | path join 'odin')"
    }
    let now = (installed-commit $bin)
    if $now != $wanted {
        error make { msg: $"post-install check failed: binary reports ($now), expected ($wanted)" }
    }
    let reported = (^$bin version | str trim | lines | first)
    print $"Verified  ($reported)"

    if $linker != null {
        let on_path = ($env.PATH | any {|p| ($p | path expand --no-symlink) == ($linker | path dirname) })
        if not $on_path {
            print $"\nWarning: ($linker | path dirname) is not on PATH."
        }
    }
}
